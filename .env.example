# 复制本文件为 .env 并填入你的 DashScope API Key
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：默认 https://dashscope.aliyuncs.com
# 素材上传后要用 GET /api/v1/files/{file_id} 换回可访问地址，
# 而该文件管理接口只在【北京 Region】开放。换到别的地域会「上传成功但拿不到 url」。
DASHSCOPE_BASE=https://dashscope.aliyuncs.com

# 可选：默认 wan3.0-video；另有 wan3.0-video-prime
WAN_MODEL=wan3.0-video

# 可选：本地端口，默认 8000
PORT=8000

# 可选：设成 1 可以让后端启动时不清空 uploads/。
# 默认是每次启动都清空 —— 上传素材只在本次会话有效，不清会白占磁盘。
KEEP_UPLOADS=0
